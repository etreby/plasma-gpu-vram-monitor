[Desktop Entry]
Name=GPU & VRAM Monitor
Comment=NVIDIA core, hotspot and VRAM temperatures, GPU load and memory usage
Icon=video-display
Type=Service
X-KDE-ServiceTypes=Plasma/Applet
X-KDE-PluginInfo-Name=local.gpu.monitor
X-KDE-PluginInfo-Version=1.0.1
X-KDE-PluginInfo-Author=etreby
X-KDE-PluginInfo-License=GPL-3.0
X-KDE-PluginInfo-Category=System Information
X-Plasma-API=declarativeappletscript
X-Plasma-MainScript=ui/main.qml
X-Plasma-RequiredExtensions=LaunchApp
X-KDE-PluginInfo-Website=https://github.com/etreby/plasma-gpu-vram-monitor
